// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Faction {
  ALLIANCE
  HORDE
  NEUTRAL
}

enum Classes {
  DEATHKNIGHT
  DEMONHUNTER
  DRUID
  EVOKER
  HUNTER
  MAGE
  MONK
  PALADIN
  PRIEST
  ROGUE
  SHAMAN
  WARLOCK
  WARRIOR
}

enum Races {
  DARKIRONDWARF
  DRACTHYR
  DRAENEI
  DWARF
  EARTHEN
  GNOME
  HARANIR
  HUMAN
  KULTIRAN
  LIGHTFORGEDDRAENEI
  MECHAGNOME
  NIGHTELF
  PANDAREN
  VOIDELF
  WORGEN
  BLOODELF
  GOBLIN
  HIGHMOUNTAINTAUREN
  MAGHARORC
  NIGHTBORNE
  ORC
  TAUREN
  TROLL
  UNDEAD
  VULPERA
  ZANDALARITROLL
}

enum Specialisations {
  BLOOD
  FROST
  UNHOLY
  HAVOC
  VENGEANCE
  DEVOURER
  BALANCE
  FERAL
  GUARDIAN
  RESTORATION
  EVOKER
  DEVASTATION
  PRESERVATION
  AUGMENTATION
  BEASTMASTERY
  MARKSMANSHIP
  SURVIVAL
  ARCANE
  FIRE
  MONK
  BREWMASTER
  MISTWEAVER
  WINDWALKER
  HOLY
  PROTECTION
  RETRIBUTION
  DISCIPLINE
  SHADOW
  ASSASSINATION
  OUTLAW
  SUBTLETY
  ELEMENTAL
  ENHANCEMENT
  AFFLICTION
  DEMONOLOGY
  DESTRUCTION
  ARMS
  FURY
}

model User {
  id              Int               @id @default(autoincrement())
  email           String?           @unique
  pseudo          String
  passwordHash    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  ExternalAccount ExternalAccount[]
  characters      Character[]
}

model ExternalAccount {
  id                Int      @id @default(autoincrement())
  userId            Int
  provider          String
  providerAccountId String
  battleTag         String?
  region            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Character {
  id                  Int              @id @default(autoincrement())
  guildId             Int?
  userId              Int
  gameVersionId       Int
  name                String
  realm               String
  region              String
  class               Classes
  race                Races?
  faction             Faction
  level               Int
  mainSpec            Specialisations?
  secondarySpec       Specialisations?
  isMain              Boolean          @default(false)
  blizzardCharacterId String?          @unique
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  lastSyncAt          DateTime?        @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([region, realm, name, gameVersionId])
}
